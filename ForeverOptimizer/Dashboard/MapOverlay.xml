<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- One pin for every recorded node / rare sighting / spawn point on the open world map.
       Logic lives in Dashboard\MapOverlay.lua (FOMapPinMixin). -->
  <Frame name="FOMapPinTemplate" mixin="FOMapPinMixin" virtual="true">
    <Size x="14" y="14"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
    </Layers>
    <!-- No OnEnter/OnLeave here: MapCanvasMixin:AcquirePin asserts they are unset and
         wires the mixin's OnMouseEnter/OnMouseLeave itself. -->
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
  <!-- One full-canvas frame per map that carries the unexplored overlay art (FOMapRevealPinMixin). -->
  <Frame name="FOMapRevealPinTemplate" mixin="FOMapRevealPinMixin" virtual="true">
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
</Ui>
